# ──────────────────────────────────────────────────────────────────────────────
# MODRIVE — Environment Variables Template
# Copy this file to .env (never commit .env)
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# CORS: comma-separated list of allowed frontend origins
# e.g. http://localhost:5173,https://modrive.example.com
ALLOWED_ORIGINS=http://localhost:5173

# ── MongoDB (Phase 3 — not needed in Phase 1) ─────────────────────────────────
# MONGODB_URI=mongodb://localhost:27017/modrive
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/modrive

# ── Auth / JWT (Phase 3) ──────────────────────────────────────────────────────
# JWT_SECRET=replace_with_a_long_random_secret
# JWT_EXPIRES_IN=7d

# ── Payments (Future) ─────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
